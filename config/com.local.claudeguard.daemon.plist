<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.claudeguard.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.local.claudeguard.daemon</string>
        <string>--preserve-network</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <!-- Time-sensitive monitoring uses explicit QoS; avoid the Background resource policy. -->
    <string>Standard</string>
    <key>StandardOutPath</key>
    <string>/var/log/claude-guard.out.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/claude-guard.err.log</string>
</dict>
</plist>
